# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=2222
DB_NAME=babeonym
DB_USER=postgres
DB_PASSWORD=your_password_here

# MySQL Wikipedia Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=wikipedia
MYSQL_USER=root
MYSQL_PASSWORD=

# Wikimedia API Configuration
# Wikimedia asks automated clients to identify themselves with a contact
# address. Used in the User-Agent for Wiktionary and Wikidata requests.
WIKIMEDIA_CONTACT=you@example.com

# Paths
WIKI_DUMP_PATH=./data/raw/wiki-dumps
NAMES_DATA_PATH=./data/raw/names
PROCESSED_DATA_PATH=./data/processed
